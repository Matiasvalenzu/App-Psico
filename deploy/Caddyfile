:3000 {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}
