# Django
DJANGO_SECRET_KEY=change-me-in-production-with-at-least-32-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
POSTGRES_DB=psicologo
POSTGRES_USER=psicologo
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# AI audio pipeline
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PYANNOTE_AUTH_TOKEN=your-pyannoteai-api-key
PYANNOTE_API_BASE_URL=https://api.pyannote.ai
PYANNOTE_API_MODEL=precision-2
PYANNOTE_API_TIMEOUT_SECONDS=3600
PYANNOTE_API_POLL_INTERVAL_SECONDS=10
PYANNOTE_API_REQUEST_TIMEOUT_SECONDS=60
PYANNOTE_API_UPLOAD_TIMEOUT_SECONDS=300
VOICE_MATCH_THRESHOLD=0.65
SPEAKER_EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb
SPEAKER_EMBEDDING_CACHE_DIR=/data/models/speechbrain
SPEAKER_EMBEDDING_DEVICE=cpu
SPEAKER_MATCH_THRESHOLD=0.35
SPEAKER_MATCH_MARGIN=0.05
SPEAKER_MIN_TURN_SECONDS=1.0
SPEAKER_MIN_TOTAL_SECONDS=3.0
SPEAKER_MAX_SECONDS_PER_LABEL=30.0
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024
EMBEDDING_USE_MODEL=False

# Audio storage
AUDIO_STORAGE_PATH=/data/audio

# Document uploads
DOCUMENT_UPLOAD_MAX_BYTES=10485760

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public links for patient test emails
# Versioned Docker Compose defaults to production: https://psico.datnexia.com
# Local development should override this in .env with: http://localhost:3000
PUBLIC_APP_URL=https://psico.datnexia.com
TEST_LINK_EXPIRATION_DAYS=7

# Transactional email through Brevo. Never commit the SMTP password.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-brevo-smtp-login
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=no-reply@datnexia.com
EMAIL_FROM_NAME=Psiconex
EMAIL_SUPPORT_ADDRESS=psiconex@datnexia.com
EMAIL_LOGO_URL=https://app.psiconex.cl/logo-psiconex.png

# Production bootstrap
DJANGO_SUPERUSER_USERNAME=Admin
DJANGO_SUPERUSER_EMAIL=admin@psicologo.local
DJANGO_SUPERUSER_PASSWORD=change-this-admin-password

# Backup
BACKUP_DIR=/backups
BACKUP_GPG_RECIPIENT=
